# Copiar como .env (no se sube a Git) y completar.

# Base de datos
REMY_DB_HOST=localhost
REMY_DB_PORT=3306
REMY_DB_USER=root
REMY_DB_PASSWORD=
REMY_DB_NAME=remy
# En el servidor de producción:
# REMY_DB_USER=arcanoposada_dev_remy
# REMY_DB_NAME=arcanoposada_remy

# Clave para firmar los tokens de sesión (cambiar en producción)
REMY_SECRET_KEY=cambiar_esta_clave

# URL de la API PHP de reservas
REMY_URL_API_RESERVAS=http://localhost/Remy_V1/modulo_reservas_php/

# Carpeta de fotos de platos (opcional; por defecto uploads/platos)
# REMY_CARPETA_IMG_PLATOS=
