# Configure these in Apache SetEnv or in the process environment. The app does not read .env automatically.
REMY_DB_HOST=localhost
REMY_DB_PORT=3306
REMY_DB_USER=
REMY_DB_PASSWORD=
REMY_DB_NAME=remy
REMY_SECRET_KEY=
REMY_BASE_PATH=
# Correo de confirmaciones (cuenta del hosting)
REMY_CORREO_REMITENTE=remy@arcano.digital
REMY_CORREO_PASSWORD=
REMY_CORREO_NOMBRE=REMY
# Opcional: direccion para respuestas, si es distinta al remitente
REMY_CORREO_RESPUESTA=
REMY_SMTP_HOST=mail.arcano.digital
REMY_SMTP_PORT=465
# ssl (puerto 465) o starttls (puerto 587)
REMY_SMTP_SEGURIDAD=ssl
